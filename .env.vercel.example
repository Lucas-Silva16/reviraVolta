# Variáveis do servidor Vercel; nunca usar NEXT_PUBLIC_ para estas opções.
# APP_ORIGIN vazio usa o domínio de produção da Vercel; nos previews usa VERCEL_URL.
APP_ORIGIN=
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=
RESEARCH_DATABASE_URL=
TOKEN_HMAC_SECRET=
SESSION_SECRET=
CRON_SECRET=
ADMIN_USERNAME=docente
ADMIN_PASSWORD_HASH=
COOKIE_MAX_AGE_DAYS=90
RETENTION_DAYS=90
REFERENCE_PRICE_PER_LITER=0.80
COURSE_GOAL_LITERS=500
MIN_COURSE_PARTICIPANTS=5
STUDY_START=
STUDY_END=
# Primeiro deploy para validar a instalação. Usar study só com protocolo configurado.
DATA_MODE=development
PROJECT_CONTACT=
PROJECT_CONTROLLER=
PROJECT_LAWFUL_BASIS=
RECRUITMENT_ATTESTATION=
