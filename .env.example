# Execute npm run setup para gerar .env com segredos locais aleatórios.
APP_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
POSTGRES_PASSWORD=
MIGRATION_DATABASE_URL=postgresql://reviravolta_owner:SUBSTITUIR@localhost:5432/reviravolta
DATABASE_URL=postgresql://reviravolta_app:SUBSTITUIR@localhost:5432/reviravolta
RESEARCH_DATABASE_URL=postgresql://reviravolta_reader:SUBSTITUIR@localhost:5432/reviravolta
APP_DB_PASSWORD=
READER_DB_PASSWORD=
TOKEN_HMAC_SECRET=
SESSION_SECRET=
# Autorização da limpeza diária na Vercel; não é necessária para o script local de retenção.
CRON_SECRET=
ADMIN_USERNAME=docente
# Formato scrypt:salt:hash; gerar com npm run setup ou node scripts/password.mjs
ADMIN_PASSWORD_HASH=
COOKIE_MAX_AGE_DAYS=90
RETENTION_DAYS=90
REFERENCE_PRICE_PER_LITER=0.80
COURSE_GOAL_LITERS=500
MIN_COURSE_PARTICIPANTS=5
STUDY_START=2026-11-13T00:00:00.000Z
STUDY_END=2026-12-04T00:00:00.000Z
# development | study | demo. study exige contacto e fundamento de licitude.
DATA_MODE=development
PROJECT_CONTACT=
PROJECT_CONTROLLER=
PROJECT_LAWFUL_BASIS=
# Confirmar fora da aplicação; nunca inferir pertença à turma a partir de cookies.
RECRUITMENT_ATTESTATION=
